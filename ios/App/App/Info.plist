<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- G171 — ana ekranda "AudioEngineerA…" diye kesildiği cihazda gözlemlendi,
	     G60'ın "Audio Engineer Academy" kararı BU TEK ALAN için geri alındı —
	     CFBundleName/uygulama içi başlıklar/App Store Connect adı DEĞİŞMEDİ,
	     bkz. DURUM.md. -->
	<key>CFBundleDisplayName</key>
	<string>AE Academy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- G121 — dikey kilit (kullanıcı onayı): uygulama dikey tasarlandı (tab
	     bar/kartlar/sheet'ler hiçbiri yatay düzen içermiyor, bkz. DURUM.md G120
	     madde 4 teşhisi). Pan Konumu/Stereo Genişlik gibi yön algısı gerektiren
	     modlarda bile kulaklık zorunlu (getMeta().kulaklikGerekli) — telefonun
	     fiziksel yönünün stereo algısına hiçbir etkisi yok, yatay desteğin
	     kaybettirdiği bir şey yok. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- G165 — AdMob ödüllü reklam. GADApplicationIdentifier SDK başlatma için
	     ZORUNLU (App ID, ad unit ID'den FARKLI — test/canlı ayrımı burada
	     DEĞİL, core/ads.js:AD_TEST_MODE'da). SKAdNetworkIdentifier, AdMob'un
	     KENDİ ağının iOS attribution kimliği (plugin'in resmi kurulum
	     talimatındaki minimum liste) — mediation ağları eklenirse Google'ın
	     daha uzun SKAdNetworkItems listesi AYRICA gerekir, bu turda
	     eklenmedi (mediation İSTENMEDİ). -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-4668080539411473~4515944558</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<!-- G165 — ATT (App Tracking Transparency). İzin isteme ZAMANLAMASI
	     burada değil, core/ads.js:doInitFlow()'da kontrol edilir — ilk
	     açılışta DEĞİL, kullanıcı ilk kez reklam izlemeye karar verdiğinde
	     (Apple'ın önerdiği bağlamsal yaklaşım). -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Reklamların sana daha uygun olması için kullanılır. İzin vermezsen reklamlar yine gösterilir, sadece kişiselleştirilmez.</string>
</dict>
</plist>
