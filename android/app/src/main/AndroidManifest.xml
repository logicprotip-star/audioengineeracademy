<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- G121 — dikey kilit (kullanıcı onayı): bkz. Info.plist'teki AYNI notu. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- G165 — AdMob ödüllü reklam. App ID (ad unit ID'den FARKLI, SDK
             başlatma için ZORUNLU) — test/canlı ayrımı burada DEĞİL,
             core/ads.js:AD_TEST_MODE'da. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id"/>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- G168 — StoreKit/Google Play Billing (@capgo/native-purchases'ın
         resmi kurulum talimatı) — bu izin olmadan Google Play Billing
         hiç başlatılamaz. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- G207 — Mağaza denetimi (14 Ağustos) kararı. ÖLÇÜLDÜ: ne bu manifest'te
         ne @capacitor-community/admob'ın KENDİ AndroidManifest'inde
         (node_modules/@capacitor-community/admob/android/src/main/AndroidManifest.xml
         — sadece ACCESS_NETWORK_STATE/INTERNET taşıyor) AD_ID izni HİÇ yoktu.
         android/app/build/ altında ÖNCEDEN üretilmiş bir merged manifest
         VARDI ama 8 Ağustos'tan (admob/native-purchases entegrasyonundan
         ÖNCESİNDEN) kalma, hatta APPLICATION_ID meta-data'sını bile
         içermiyordu — GÜNCEL bağımlılık kümesini YANSITMIYOR, bu ortamda
         Java/Gradle YOK, taze bir build alıp GERÇEK merge sonucunu
         DOĞRULAYAMADIM. play-services-ads:24.9.+ (build.gradle'daki sürüm)
         Google'ın KENDİ SDK notlarına göre v20.4.0'dan beri bu izni genelde
         kendi AAR'ından otomatik ekliyor, ama BU PROJEDE KANITLANAMADI —
         bu yüzden tahmine güvenmek yerine ELLE eklendi (Android manifest
         merger AYNI iznin TEKRAR beyan edilmesinden rahatsız olmaz, zararsız/
         idempotent) — bkz. rapor. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
